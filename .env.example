# 复制为 .env 并填写；.env 已被 .gitignore 忽略，切勿提交真实密钥
# ---------------------------------------------------------------
# LLM（OpenAI 兼容接口）—— llm.enabled=true 时必填
OPENAI_API_KEY=

# 币安实盘/测试网 API —— execution.broker=binance 且 dry_run=false 时必填
BINANCE_API_KEY=
BINANCE_API_SECRET=

# 其他
# AAAAI_CONFIG=config/default.yaml   # 指定配置文件路径
# AAAAI_AUTOSTART=1                  # 服务启动时自动跑一次回测（0 关闭）

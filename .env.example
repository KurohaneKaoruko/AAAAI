# 复制为 .env 并填写；.env 已被 .gitignore 忽略，切勿提交真实密钥
# ---------------------------------------------------------------
# ============================================================
# 命名规则
#   - AAAAI 自己的配置项：加 AAAAI_ 前缀（避免与宿主机其它程序撞名）
#   - 第三方生态变量：保持标准名，不加前缀（与各家文档/CI 约定一致）
# ============================================================

# ---- 第三方变量（可在面板里逐个实例填写，此处为全局默认值）----
# LLM（OpenAI 兼容）：实例密钥也可在「LLM 大模型」页单独配置
OPENAI_API_KEY=
# 币安实盘/测试网
BINANCE_API_KEY=
BINANCE_API_SECRET= # 如需，可填 OKX_API_KEY / OKX_API_SECRET / OKX_API_PASSPHRASE

# ---- 可选鉴权（留空 = 不启用鉴权）----
# 三种方式任选其一或组合：
# 1) 面板登录（用户名 + 口令），登录后下发 HttpOnly 会话 Cookie
# AAAAI_AUTH_USERNAME=admin
# AAAAI_AUTH_PASSWORD=换成你的强口令
# AAAAI_AUTH_SESSION_HOURS=12          # 会话有效期（小时）
# 2) API Token：请求头 Authorization: Bearer <token>（SSE 可用 ?token=）
# AAAAI_AUTH_TOKEN=换成你的长随机串

# ---- 其他 ----
# AAAAI_CONFIG=config/default.yaml   # 指定配置文件路径
# AAAAI_DATA_DIR=data                 # 运行时数据目录
# AAAAI_AUTOSTART=1                   # 启动时自动跑一次回测（0 关闭）

# ---- Docker Compose 变量 ----
# AAAAI_PORT=8787                     # 宿主机映射端口
# TZ=Asia/Shanghai
